{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "PublicRead",
            "Effect": "Allow",
            "Principal": "*",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::oasis-ehs-bucket/*"
        },
        {
            "Sid": "AllowAllS3Actions",
            "Effect": "Allow",
            "Principal": {
                "AWS": "*"
            },
            "Action": [
                "s3:*"
            ],
            "Resource": [
                "arn:aws:s3:::oasis-ehs-bucket",
                "arn:aws:s3:::oasis-ehs-bucket/*"
            ]
        }
    ]
}
