# EHS Suite Backend - Environment Variables Template
# Copy this file to .env and fill in your actual values
# ⚠️ NEVER commit .env file to git - it's in .gitignore for security

# ========== Database Configuration ==========
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://oasis:your_password_here@dpg-d95i9fpoagis738st8p0-a.oregon-postgres.render.com/ehsdb_o0dm

# ========== Server Configuration ==========
# Node environment (development, production, test)
NODE_ENV=development

# Server port (Render will override this to 5000 in production)
PORT=5000

# ========== JWT Authentication ==========
# Secret key for signing JWT tokens
# IMPORTANT: Use a strong, random string (min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_secure_jwt_secret_key_change_in_production_12345

# ========== AWS S3 Configuration ==========
# AWS IAM User Access Key
AWS_ACCESS_KEY_ID=your_actual_aws_access_key_id

# AWS IAM User Secret Key
# IMPORTANT: Keep this secret - never share or commit
AWS_SECRET_ACCESS_KEY=your_actual_aws_secret_access_key

# AWS Region where S3 bucket is located
AWS_REGION=us-east-1

# S3 Bucket name
AWS_S3_BUCKET=oasis-ehs-bucket

# S3 bucket base URL
AWS_S3_URL=https://oasis-ehs-bucket.s3.amazonaws.com

# ========== Brevo SMTP Email Configuration ==========
# Brevo SMTP relay: https://app.brevo.com/settings/keys/smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=EHSSuite

# Public URL of your app (used in password reset email links)
APP_BASE_URL=http://localhost:5000

# ========== Application Logging ==========
# Log level: debug | info | warn | error
APP_LOG_LEVEL=debug

# Daily rotated application logs (application-YYYY-MM-DD.log)
APP_LOG_ROTATE_DAILY=true

# Keep rotated logs for this many days before cleanup
APP_LOG_RETENTION_DAYS=14

# Optional custom log output path (base file name)
# APP_LOG_FILE=./logs/application.log

# ========== Documentation ==========
# How to set up these variables:

# 1. DATABASE_URL:
#    Get from Render PostgreSQL instance
#    Format: postgresql://user:password@host:port/dbname
#    Our instance: https://render.com > PostgreSQL > Connection String

# 2. JWT_SECRET:
#    Generate strong random string:
#    - Using OpenSSL: openssl rand -base64 32
#    - Using Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#    - Minimum: 32 characters
#    - Use different value for production

# 3. AWS_ACCESS_KEY_ID & AWS_SECRET_ACCESS_KEY:
#    Get from AWS IAM User credentials
#    - Go to AWS Console > IAM > Users > Select User > Security Credentials
#    - Create new Access Key if needed
#    - Download and store securely

# 4. AWS_S3_BUCKET & AWS_S3_URL:
#    - BUCKET: Name of your S3 bucket (e.g., oasis-ehs-bucket)
#    - URL: Format: https://bucket-name.s3.amazonaws.com

# 5. Brevo SMTP:
#    - Create/Copy SMTP credentials from Brevo dashboard
#    - SMTP host: smtp-relay.brevo.com
#    - Common port: 587 (STARTTLS, SMTP_SECURE=false)
#    - Sender email should be verified in Brevo for best deliverability

# ========== Security Notes ==========
# ⚠️ NEVER commit this file with real values to git
# ⚠️ Keep AWS credentials confidential
# ⚠️ Rotate JWT_SECRET and AWS keys periodically
# ⚠️ Use different secrets for development vs production
# ⚠️ For Render deployment: Set env vars in Render dashboard, not in code
